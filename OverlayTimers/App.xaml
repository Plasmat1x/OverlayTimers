<Application x:Class="OverlayTimers.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OverlayTimers"
			 xmlns:tb="http://www.hardcodet.net/taskbar"
             StartupUri="OverlayWindow.xaml">
	<Application.Resources>
		<tb:TaskbarIcon x:Key="TrayIcon"
                        ToolTipText="Оверлей Таймеры"
                        IconSource="/Resources/Icon.ico">
			<tb:TaskbarIcon.ContextMenu>
				<ContextMenu>
					<MenuItem Header="Настройки" Click="MenuSettings_Click" FontWeight="Bold"/>
					<Separator/>
					<MenuItem Header="Выход" Click="MenuExit_Click"/>
				</ContextMenu>
			</tb:TaskbarIcon.ContextMenu>
		</tb:TaskbarIcon>
	</Application.Resources>
</Application>
